default_platform(:ios)

XCODEPROJ = "MemoryMutt.xcodeproj"
SCHEME    = "MemoryMutt"

platform :ios do
  # App Store Connect API key auth. Set these in fastlane/.env (see .env.example).
  # Any lane that talks to App Store Connect calls this first; gym/pilot/deliver
  # pick the key up from lane_context automatically.
  private_lane :asc_auth do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV["ASC_KEY_FILEPATH"] || "fastlane/private/AuthKey.p8",
      duration: 1200,
      in_house: false
    )
  end

  desc "Compile the app without signing — a fast sanity check before a real build"
  lane :build do
    gym(
      scheme: SCHEME,
      configuration: "Debug",
      skip_package_ipa: true,
      skip_archive: true,
      destination: "generic/platform=iOS Simulator",
      skip_codesigning: true
    )
  end

  desc "Capture App Store screenshots: iPhone and iPad (see Snapfile), then Apple Watch"
  lane :screenshots do
    # snapshot clears the output folder first, so the watch shots must come after it.
    snapshot
    watch_screenshots
  end

  desc "Capture Apple Watch screenshots (snapshot can't drive watchOS, so this uses simctl)"
  lane :watch_screenshots do
    root    = File.expand_path("..", __dir__)
    device  = "Apple Watch Ultra 3 (49mm)"   # 422x514, which App Store Connect files as Watch Ultra
    out_dir = File.join(root, "fastlane/screenshots/en-US")
    derived = File.join(root, "build/watch-screenshots")
    bundle  = "com.manicmutt.MemoryMutt.watchkitapp"

    # Newest runtime that has this device.
    require "json"
    runtimes = JSON.parse(sh("xcrun simctl list devices available -j", log: false))["devices"]
    udid = runtimes.select { |rt, _| rt.include?("watchOS") }
                   .sort_by { |rt, _| rt.scan(/\d+/).map(&:to_i) }
                   .reverse
                   .flat_map { |_, devices| devices }
                   .find { |d| d["name"] == device }&.fetch("udid")
    UI.user_error!("No '#{device}' simulator found — add one in Xcode > Devices") unless udid

    sh("xcodebuild -project #{root}/#{XCODEPROJ} -scheme MemoryMuttWatch -configuration Debug " \
       "-destination 'id=#{udid}' -derivedDataPath '#{derived}' build -quiet")

    sh("xcrun simctl boot #{udid} || true")
    sh("xcrun simctl bootstatus #{udid} -b", log: false)
    sh("xcrun simctl status_bar #{udid} override --time 9:41 || true")
    sh("xcrun simctl install #{udid} '#{derived}/Build/Products/Debug-watchsimulator/MemoryMuttWatch.app'")

    FileUtils.mkdir_p(out_dir)
    { "01_Decks" => "decks", "02_Question" => "question", "03_Answer" => "answer" }.each do |name, screen|
      sh("xcrun simctl terminate #{udid} #{bundle} || true", log: false)
      sh("xcrun simctl launch #{udid} #{bundle} -ScreenshotMode -ScreenshotScreen #{screen}")
      sleep(4)
      sh("xcrun simctl io #{udid} screenshot '#{out_dir}/#{device}-#{name}.png'")
    end
    sh("xcrun simctl terminate #{udid} #{bundle} || true", log: false)
  end

  desc "Upload fastlane/screenshots to App Store Connect, replacing what's there"
  lane :upload_screenshots do
    asc_auth
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false   # nothing is submitted here
    )
  end

  desc "Capture screenshots and upload them in one go"
  lane :refresh_screenshots do
    screenshots
    upload_screenshots
  end

  desc "Bump the build number, archive, and upload to TestFlight (internal testers)"
  lane :beta do |options|
    asc_auth
    increment_build_number(xcodeproj: XCODEPROJ) unless options[:skip_build_increment]
    gym(scheme: SCHEME, export_method: "app-store")
    pilot(skip_waiting_for_build_processing: true)
  end

  desc "Same as beta, but also distributes to the External Testers group"
  lane :beta_external do |options|
    asc_auth
    increment_build_number(xcodeproj: XCODEPROJ)
    gym(scheme: SCHEME, export_method: "app-store")
    pilot(
      distribute_external: true,
      groups: ["External Testers"],
      changelog: options[:changelog] || "Bug fixes and improvements",
      skip_waiting_for_build_processing: false
    )
  end

  desc "Submit the latest TestFlight build for App Store review (no new build)"
  lane :release do
    asc_auth
    deliver(
      build_number: latest_testflight_build_number.to_s,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      # precheck can't inspect IAPs (the tip jar) under API-key auth, and errors out.
      precheck_include_in_app_purchases: false
    )
  end

  desc "Build a fresh version, upload it, and submit for review. Pass version:1.22 to bump."
  lane :release_full do |options|
    asc_auth
    increment_version_number(xcodeproj: XCODEPROJ, version_number: options[:version]) if options[:version]
    increment_build_number(xcodeproj: XCODEPROJ)
    gym(scheme: SCHEME, export_method: "app-store")
    deliver(
      submit_for_review: true,
      automatic_release: options[:auto_release] == true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
